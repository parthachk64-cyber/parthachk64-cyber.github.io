---
import '@fontsource/barlow-semi-condensed/latin-500.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  preloadHero?: { href: string; srcset: string };
}
const { title, description, preloadHero } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? '';
const canonical = new URL(base, site).href;
const og = new URL(`${base}og/og-image.jpg`, site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: canonical,
  sameAs: profile.links.map((l) => l.href),
  knowsAbout: ['Artificial intelligence for cybersecurity', 'Cyber threat intelligence', 'Cloud security', 'Critical infrastructure protection'],
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070d1c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {preloadHero && <link rel="preload" as="image" type="image/webp" href={preloadHero.href} imagesrcset={preloadHero.srcset} imagesizes="(min-width: 960px) 58vw, 100vw" />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        // Motion is permanently on by design: no toggle, no stored preference, no reduced-motion opt-out.
        try { localStorage.removeItem('motion'); } catch (e) {}
        d.setAttribute('data-motion', 'on');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
